{
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/bp/webapp/(.*)$",
      "target": "$1",
      "localDir": "bp/webapp",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    }
  ]
}
