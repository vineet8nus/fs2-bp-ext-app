{
  "_version": "1.59.0",
  "sap.app": {
    "id": "nus.bp.changerequest",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "mainService": {
        "uri": "/bp/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "localUri": "localService/metadata.xml"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "bp-manage": {
          "semanticObject": "BusinessPartnerRequest",
          "action": "manage",
          "title": "{{appTitle}}",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "nus.bp.changerequest.i18n.i18n" }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ChangeRequestsList",
          "target": "ChangeRequestsList"
        },
        {
          "pattern": "ChangeRequests({key}):?query:",
          "name": "ChangeRequestsObjectPage",
          "target": "ChangeRequestsObjectPage"
        }
      ],
      "targets": {
        "ChangeRequestsList": {
          "type": "Component",
          "id": "ChangeRequestsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ChangeRequests",
              "variantManagement": "None",
              "initialLoad": true,
              "navigation": {
                "ChangeRequests": {
                  "detail": { "route": "ChangeRequestsObjectPage" }
                }
              }
            }
          }
        },
        "ChangeRequestsObjectPage": {
          "type": "Component",
          "id": "ChangeRequestsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/ChangeRequests",
              "editableHeaderContent": false
            }
          }
        }
      }
    },
    "contentDensities": { "compact": true, "cozy": true }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
